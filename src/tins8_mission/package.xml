<?xml version="1.0"?>
<package format="3">
  <name>tins8_mission</name>
  <version>1.0.1</version>
  <description>Mission, control, perception (YOLOX), IBVS pursuit, CLI and GUI nodes for the TinS-12E 8-UAV course build.</description>
  <maintainer email="student@example.com">COE 510 student</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>tins8_interfaces</depend>
  <depend>px4_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>action_msgs</depend>
  <exec_depend>tins8_gazebo</exec_depend>
  <exec_depend>tins_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
